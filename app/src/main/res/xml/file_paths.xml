<?xml version="1.0" encoding="utf-8"?>
<!-- Пути, которые FileProvider может отдавать внешним приложениям (просмотр PDF ДТП) -->
<paths>
    <files-path name="documents" path="documents/" />
    <!-- Файл диагностического журнала, который пользователь прикладывает к письму -->
    <files-path name="diagnostics" path="diagnostics/" />
</paths>
