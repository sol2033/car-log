    <!-- What's new -->
    <string name="whats_new_title">What\'s new in %1$s</string>
    <string name="whats_new_confirm">Got it</string>
    <string name="whats_new_fuel_reset_title">Fuel consumption can be restarted</string>
    <string name="whats_new_fuel_reset_body">a missed refueling no longer skews the average forever: the statistics screen has a button next to the average — counting restarts from the next refueling you add. The calculation itself got more accurate: the first tank no longer inflates the average.</string>
    <string name="whats_new_works_title">Works as a list</string>
    <string name="whats_new_works_body">in repairs, scheduled service and tuning you can list the service works with their prices — their sum becomes the labor cost.</string>
    <string name="whats_new_to_consumables_title">Consumables in service got easier</string>
    <string name="whats_new_to_consumables_body">volume is asked only for fluids, one replacement interval is enough, and one-off items now have the "Other" category — it stays out of the Consumables section. Consumables and works are now visible in the record card.</string>
    <string name="whats_new_hidden_parts_title">Not everything belongs in Parts</string>
    <string name="whats_new_hidden_parts_body">parts added in a repair or tuning now have a visibility checkbox: small items like gaskets can stay inside the record instead of cluttering the section. Their cost still counts.</string>

